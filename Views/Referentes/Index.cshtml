@{
    ViewData["Title"] = "Referentes";
}

<section class="page-header">
    <div>
        <h2 class="page-title">Referentes</h2>
        <p class="page-description">
            Administración de las personas registradas como referentes.
        </p>
    </div>

    <button type="button" class="btn btn-primary">
        <i class="bi bi-person-plus me-2"></i>
        Agregar referente
    </button>
</section>

<section class="content-card">
    <div class="content-card-header">
        <div>
            <h3 class="content-card-title">Listado de referentes</h3>
            <p class="content-card-description">
                Buscá un referente por DNI, nombre o localidad.
            </p>
        </div>

        <div class="search-box">
            <i class="bi bi-search"></i>

            <input type="search"
                   class="form-control"
                   placeholder="Buscar referente..."
                   aria-label="Buscar referente" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">DNI</th>
                    <th scope="col">Apellido y nombre</th>
                    <th scope="col">Localidad</th>
                    <th scope="col">Asignados</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="5">
                        <div class="table-empty-state">
                            <i class="bi bi-person-badge"></i>
                            <strong>No hay referentes registrados</strong>
                            <span>
                                Los referentes aparecerán aquí cuando sean incorporados al sistema.
                            </span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>